# Default fixture mode never calls a provider.
SOURCE_TRAIL_MODE=fixture
# Explicit hosted mode may consume account credits. Configure privately:
# SOURCE_TRAIL_MODE=otari
OTARI_API_KEY=
OTARI_MODEL=
# us or eu; never auto-follow a 421 region hint or redirect.
OTARI_REGION=us
# Needed only for the localhost HTTP API. Use a private random value >=32 chars.
SOURCE_TRAIL_API_TOKEN=
